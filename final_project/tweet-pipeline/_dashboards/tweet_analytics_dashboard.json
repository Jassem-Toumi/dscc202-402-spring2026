{
  "datasets": [
    {
      "name": "ba981161",
      "displayName": "Total Number of Tweets Summary Dataset",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets \n",
        "FROM workspace.default.tweets_bronze"
      ]
    },
    {
      "name": "6e345ea3",
      "displayName": "Mentioned Tweets Count Analysis",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_with_mentions \n",
        "FROM workspace.default.tweets_silver \n",
        "WHERE mention IS NOT NULL"
      ]
    },
    {
      "name": "8815a4b4",
      "displayName": "Tweets Count Missing Mention Details",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_without_mentions \n",
        "FROM workspace.default.tweets_silver \n",
        "WHERE mention IS NULL"
      ]
    },
    {
      "name": "4b6973a8",
      "displayName": "Top Ten Users Ranked by Number of Tweets",
      "queryLines": [
        "SELECT user, COUNT(*) AS tweet_count \n",
        "FROM workspace.default.tweets_bronze \n",
        "GROUP BY user \n",
        "ORDER BY tweet_count DESC \n",
        "LIMIT 10"
      ]
    },
    {
      "name": "d30311c7",
      "displayName": "Top Ten Positive Mentions from Tweets",
      "queryLines": [
        "SELECT mention, positive \n",
        "FROM workspace.default.gold_tweet_aggregations \n",
        "ORDER BY positive DESC LIMIT 10"
      ]
    },
    {
      "name": "52fdbb45",
      "displayName": "Top Mentions Ranked by Negative Sentiment Score",
      "queryLines": [
        "SELECT mention, negative \n",
        "FROM workspace.default.gold_tweet_aggregations \n",
        "ORDER BY negative DESC LIMIT 10"
      ]
    }
  ],
